# ============================================================
# IMChat 本地环境变量模板
# 用法：cp .env.example .env，填上下面 3 个空值即可启动
#      （.env 已存在时 cp 会整文件覆盖，别在已经填好密钥的机器上直接执行）
#
# 生效方式：服务启动时读取**当前工作目录**下的 .env（见 internal/config/dotenv.go）
# 优先级：真实环境变量 > .env > config/config.yaml
#
# 只列 yaml 里为空、必须外部注入的项：
# MySQL / Redis / RabbitMQ / JWT / server.addr 在 yaml 里已有非空值，
# 写进来就是拿同样的值覆盖同样的值，改 yaml 时反而会被这里的旧值盖住。
# 确实需要覆盖时（本机端口冲突、连别的 MySQL 实例），可覆盖项清单见
# docs/deploy.md 的「四、环境变量」，那 12 个键都能写在这里。
#
# 注意：值里出现「空白 + #」会被当成行内注释截断，密钥含 # 必须用引号包住，
#       例：IMCHAT_OSS_ACCESS_KEY_SECRET="ab#cd"
# ============================================================

# ---------- 阿里云 OSS ----------
# bucket 所在区域的访问域名。yaml 默认华北2（北京）oss-cn-beijing.aliyuncs.com，
# 换区域才取消注释
# IMCHAT_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
IMCHAT_OSS_BUCKET=
IMCHAT_OSS_ACCESS_KEY_ID=
IMCHAT_OSS_ACCESS_KEY_SECRET=

# private | public-read | public-read-write | default
# 桶是私有的、图片又要按 URL 直读时必须 public-read，否则上传成功但访问 403
IMCHAT_OSS_ACL=public-read

# 接了 CDN 再取消注释并填 CDN 域名；留空时按 https://{bucket}.{endpoint} 推导
# IMCHAT_UPLOAD_PUBLIC_BASE=https://cdn.example.com
